{
  "name": "volume-profiles",
  "version": "7.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "bun setup",
    "presetup": "bun scripts/setup.js",
    "setup": "spicetify enable-devtools",
    "postsetup": "lefthook install",
    "upgradeDeps": "bun update --interactive",
    "audit": "bun audit",
    "lint": "biome check --write",
    "build": "spicetify-creator",
    "postbuild": "spicetify apply",
    "build-local": "bun scripts/build-local.ts",
    "build-local-nominify": "bun scripts/build-local.ts --no-minify",
    "watch": "spicetify-creator --watch"
  },
  "dependencies": {
    "spcr-settings": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/bun": "^1.3.5",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "ini": "^6.0.0",
    "lefthook": "^2.0.13",
    "semver": "^7.7.3",
    "spicetify-creator": "^1.0.17"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook" 
  ],
  "untrustedDependencies": [
    "esbuild"
  ]
}